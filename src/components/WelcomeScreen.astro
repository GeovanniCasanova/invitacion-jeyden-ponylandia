---
import { event } from '../../config/event';
---

<section
  class="relative min-h-screen overflow-hidden welcome-bg flex flex-col items-center"
  aria-label="Bienvenida"
>
  <!-- Halo dorado detrás de la imagen -->
  <div
    class="absolute top-[74px] left-1/2 -translate-x-1/2 w-[118px] h-[118px] rounded-full halo-gold pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Arbustos decorativos inferiores -->
  <div
    class="absolute bottom-0 -left-16 w-80 h-48 rounded-[50%_50%_0_0] bg-ranch-grass pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute bottom-0 -right-16 w-72 h-36 rounded-[50%_50%_0_0] bg-ranch-green pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Suelo de madera -->
  <div
    class="absolute bottom-0 left-0 right-0 h-11 wood-floor pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Contenido principal -->
  <div class="relative flex flex-col items-center w-full max-w-sm mx-auto px-8 pt-10 pb-16 flex-1">

    <!-- Barra superior "PONYLANDIA" con postes -->
    <div class="w-full relative">
      <div
        class="h-11 rounded-lg wood-bar-sm flex items-center justify-center shadow-[inset_0_-4px_0_rgba(0,0,0,0.18),0_4px_0_rgba(36,23,15,0.15)]"
      >
        <span class="font-heading font-bold text-[15px] tracking-[0.24em] text-ranch-cream [text-shadow:0_1px_0_rgba(0,0,0,0.35)]">
          PONYLANDIA
        </span>
      </div>
      <!-- Postes verticales -->
      <div
        class="absolute top-11 left-2 w-4 h-64 wood-post rounded-b-sm pointer-events-none"
        aria-hidden="true"
      ></div>
      <div
        class="absolute top-11 right-2 w-4 h-64 wood-post rounded-b-sm pointer-events-none"
        aria-hidden="true"
      ></div>
    </div>

    <!-- Ilustración del pavo saludando -->
    <div class="mt-3.5 w-[236px] h-[286px] reveal" aria-hidden="false">
      <img
        src="/images/art/pavo_saludando.png"
        alt="Pavo real vaquero saludando"
        class="w-full h-full object-contain"
        loading="eager"
        decoding="async"
        width="236"
        height="286"
      />
    </div>

    <!-- Título y subtítulo -->
    <h1
      class="mt-3.5 text-center font-heading font-bold text-[27px] leading-[1.15] text-ranch-primary text-pretty reveal"
      data-delay="1"
    >
      {event.tagline}
    </h1>
    <p
      class="mt-2 text-center font-body font-semibold text-[13px] leading-relaxed text-ranch-dark/60 tracking-[0.02em] reveal"
      data-delay="2"
    >
      16 DE AGOSTO · 2:30 P. M.
    </p>

    <!-- CTA y label -->
    <div class="mt-auto w-full flex flex-col gap-2.5 items-center">
      <a
        href="#hero"
        class="w-full h-[68px] flex items-center justify-center rounded-[18px] bg-ranch-primary text-ranch-cream-light font-heading font-bold text-xl tracking-[0.01em] shadow-[0_8px_0_#093943,0_18px_30px_rgba(14,74,86,0.38)] animate-pulse-btn no-underline reveal"
        data-delay="3"
        aria-label="Abrir invitación de cumpleaños"
      >
        Abrir invitación
      </a>
      <span
        class="font-body font-bold text-[11px] text-ranch-cream-light/90 tracking-[0.1em] [text-shadow:0_1px_2px_rgba(36,23,15,0.45)] reveal"
        data-delay="4"
      >
        VESTIMENTA VAQUERA OPCIONAL
      </span>
    </div>
  </div>
</section>
