---
---

<section
  id="photo-gallery"
  class="relative min-h-screen overflow-hidden bg-ranch-cream flex flex-col"
  aria-label="Sesión de fotos de Jeyden"
>
  <!-- Barra de madera superior -->
  <div
    class="absolute top-0 left-0 right-0 h-[78px] wood-bar shadow-[inset_0_-5px_0_rgba(0,0,0,0.2)] pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Contenido -->
  <div class="relative flex flex-col w-full max-w-sm mx-auto px-5 pt-7 pb-10 flex-1">

    <!-- Label -->
    <span class="font-body font-bold text-[11px] tracking-[0.26em] text-ranch-cream-light mt-1">
      SESIÓN DE FOTOS
    </span>

    <!-- Foto estrella -->
    <div class="relative mt-10 rounded-2xl overflow-hidden shadow-xl reveal-scale">
      <img
        src="/images/art/foto_estrella_jeyden_pseando_caballo.jpeg"
        alt="Jeyden con su caballo blanco al atardecer"
        class="w-full object-cover aspect-[3/2]"
        loading="lazy"
        decoding="async"
        width="720"
        height="480"
      />
      <!-- Overlay gradiente con nombre -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent flex flex-col justify-end px-4 pb-4">
        <p class="font-heading font-bold text-[20px] text-white leading-tight">Jeyden</p>
        <p class="font-body text-[12px] text-white/75 tracking-[0.14em]">9 AÑOS · PONYLANDIA</p>
      </div>
    </div>

    <!-- Strip de fotos verticales -->
    <div
      class="mt-4 flex gap-3 overflow-x-auto pb-2 snap-x snap-mandatory reveal"
      data-delay="1"
      style="scrollbar-width: none;"
    >
      <img
        src="/images/art/jeyden_montando_caballo_viendo_camara.jpeg"
        alt="Jeyden montado en su caballo mirando a cámara"
        class="h-56 w-auto rounded-xl object-cover shrink-0 snap-center ring-1 ring-ranch-brown/15 shadow-md"
        loading="lazy"
        decoding="async"
        height="224"
      />
      <img
        src="/images/art/jeyden_montanto_caballo.jpeg"
        alt="Jeyden montado en el portón de Ponylandia"
        class="h-56 w-auto rounded-xl object-cover shrink-0 snap-center ring-1 ring-ranch-brown/15 shadow-md"
        loading="lazy"
        decoding="async"
        height="224"
      />
      <img
        src="/images/art/jeyden_posando_vaquero.jpeg"
        alt="Jeyden posando como vaquero"
        class="h-56 w-auto rounded-xl object-cover shrink-0 snap-center ring-1 ring-ranch-brown/15 shadow-md"
        loading="lazy"
        decoding="async"
        height="224"
      />
      <img
        src="/images/art/jeyden_sonriendo_vaquero_montando_caballo.jpeg"
        alt="Jeyden sonriendo montado en su caballo"
        class="h-56 w-auto rounded-xl object-cover shrink-0 snap-center ring-1 ring-ranch-brown/15 shadow-md"
        loading="lazy"
        decoding="async"
        height="224"
      />
    </div>

    <!-- Indicador de scroll -->
    <p class="mt-2 text-center font-body text-[10px] text-ranch-dark/35 tracking-[0.12em]">
      ← DESLIZA →
    </p>

  </div>
</section>
