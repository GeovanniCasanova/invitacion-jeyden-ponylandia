---
import Layout from '../layouts/Layout.astro';
import WelcomeScreen from '../components/WelcomeScreen.astro';
import HeroScreen from '../components/HeroScreen.astro';
import InfoScreen from '../components/InfoScreen.astro';
import DressCodeScreen from '../components/DressCodeScreen.astro';
import ConfirmationScreen from '../components/ConfirmationScreen';
import FarewellScreen from '../components/FarewellScreen.astro';
import GiftsScreen from '../components/GiftsScreen.astro';
import PhotoScreen from '../components/PhotoScreen.astro';
import MusicModal from '../components/MusicModal';
import { event } from '../../config/event';
---

<Layout
  title={`¡${event.name} Cumple ${event.age} años! · ${event.venue}`}
  description={`¡${event.name} Canto cumple ${event.age} años! Acompáñanos a vivir una aventura en la granja ${event.venue} el ${event.dateDisplay} a las ${event.timeDisplay}. Confirma tu asistencia por WhatsApp.`}
>
  <!-- Modal de música -->
  <MusicModal client:load />

  <!-- Botón flotante: Ver galería -->
  <a
    href="#photo-gallery"
    class="fixed bottom-6 left-6 z-40 flex items-center gap-1.5 px-4 h-11 rounded-full bg-ranch-gold text-ranch-dark font-heading font-bold text-[13px] shadow-[0_4px_0_#8B6914] no-underline active:translate-y-1 active:shadow-[0_1px_0_#8B6914] transition-transform"
    aria-label="Ver galería de fotos de Jeyden"
  >
    📸 Ver galería
  </a>

  <!-- Pantalla 01: Bienvenida -->
  <WelcomeScreen />

  <!-- Pantalla 02: Hero -->
  <HeroScreen />

  <!-- Pantallas 03+04: Información y Vestimenta (2 columnas en desktop) -->
  <div class="lg:grid lg:grid-cols-2 lg:max-w-[1120px] lg:mx-auto">
    <InfoScreen />
    <DressCodeScreen />
  </div>

  <!-- Pantalla 05: Sesión de fotos -->
  <PhotoScreen />

  <!-- Pantalla 06: Guía de regalos -->
  <GiftsScreen />

  <!-- Pantalla 07: Confirmación -->
  <ConfirmationScreen client:load />

  <!-- Pantalla 08: Despedida -->
  <FarewellScreen />
</Layout>
